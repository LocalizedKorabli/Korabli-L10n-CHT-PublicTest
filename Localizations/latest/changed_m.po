msgid "IDS_BY_EXPERIENCE"
msgstr "基本經驗"

msgid "IDS_CONTEXT_BATTLE_AGAINST_SUBMARINE_HINT"
msgstr "發現水下的潛水艇後，使用深水炸彈"

msgid "IDS_CONTEXT_ENEMY_SUBMARINE_WAVED_PLAYER_SUBMARINE_HINT"
msgstr "潛水艇被聲納音波命中！您可能成為敵方潛水艇魚雷的目標。"

msgid "IDS_CONTEXT_ENEMY_SUBMARINE_WAVED_RESET_HINT"
msgstr "使用損害管制小組消耗品來阻止敵方潛水艇發射的魚雷進行制導"

msgid "IDS_CONTEXT_ENEMY_SUBMARINE_WAVED_US_HINT"
msgstr "艦艇被聲納音波命中！您可能成為敵方潛水艇魚雷的目標。"

msgid "IDS_CONTEXT_OIL_LEAK_PENDING_HINT"
msgstr "燃油系統受損。位於水下的潛水艇將在水面上留下明顯的油跡"

msgid "IDS_CONTEXT_PINGER_GUN_HOW_TO"
msgstr "使用聲納音波命中敵艦以將其設定為魚雷的目標"

msgid "IDS_CONTEXT_PINGER_GUN_TORPEDOES_SHOT"
msgstr "被聲納音波標記的艦艇將成為您之後發射魚雷的目標"

msgid "IDS_CONTEXT_SUBMARINE_MULTIPLE_TARGETS_HINT"
msgstr "想要同時攻擊多個目標，使用聲納音波命中不同艦艇併發射魚雷。"

msgid "IDS_CONTEXT_SUBMARINE_SELECT_ACTIVE_WAVE_HIT"
msgstr "用聲納音波標記另一艘艦艇，下一枚魚雷將以它為目標"

msgid "IDS_CONTEXT_TUTORIAL_SUBMARINE_PERISCOPE"
msgstr "位於潛望深度時：不消耗下潛能力，並會持續進行被動聲納定位；但航速降低，對艦艇的偵察範圍縮小"

msgid "IDS_CONTEXT_TUTORIAL_SUBMARINE_WORKING"
msgstr "位於工作深度時：航速較高，並會持續進行被動聲納定位；但對艦艇的偵察範圍大幅縮小"

msgid "IDS_CURRENCY_EVENTUM_1"
msgstr "海軍代幣"

msgid "IDS_CURRENCY_EVENTUM_1_GET_DESCRIPTION"
msgstr "透過在 25.7 版本的有限時間內完成作戰任務，以及在 25.7 版本結束前從軍械庫的禮包中獲得。"

msgid "IDS_CURRENCY_EVENTUM_1_SPEND_DESCRIPTION"
msgstr "用於在 25.7 版本結束前兌換 IX 階巡洋艦謝爾巴科夫和 VIII 階巡洋艦德米特里•波扎爾斯基，謝爾巴科夫和 X 階戰列艦紅旗的永久迷彩「輝煌」，「海洋盛典」加值貨櫃以及其他資源。"

msgid "IDS_CURRENCY_EVENTUM_1_STATUS"
msgstr "臨時資源。25.8 版本釋出後，代幣將被無償收回。"

msgid "IDS_CURRENCY_EVENTUM_3"
msgstr "法國代幣"

msgid "IDS_CURRENCY_EVENTUM_3_GET_DESCRIPTION"
msgstr "透過在 25.7 版本結束前完成作戰任務、達到戰鬥通行證等級，以及在 25.8 版本結束前從軍械庫的禮包中獲得。"

msgid "IDS_CURRENCY_EVENTUM_3_SPEND_DESCRIPTION"
msgstr "用於在 25.8 版本結束前兌換包含以下內容的連續禮包鏈：VIII 階潛水艇非洲女郎，X 階潛水艇卡薩比安卡，VI 階潛水艇黛安和非洲女郎的永久加成包，非洲女郎和卡薩比安卡的永久迷彩，以及其他資源。"

msgid "IDS_CURRENCY_EVENTUM_3_STATUS"
msgstr "「法國潛水艇」活動的臨時資源。25.9 版本釋出後，代幣將被無償收回。"

msgid "IDS_DOCK_AMMO_DESCRIPTION_AIRSUPPORT_DEPTHCHARGE"
msgstr "<p>用深水炸彈對標記區域進行空中轟炸。</p><p class=\"p_spacing\"> </p><p>深水炸彈將在水中停留一段時間，於潛水艇或其他目標附近引爆。有機率癱瘓配件，引發火災、進水。較容易癱瘓敵方潛水艇的聲納。可拆毀魚雷與水雷，並對水面艦艇造成輕微傷害。</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_AIRSUPPORT_DEPTHCHARGE_AUTO"
msgstr "<p>若潛水艇暴露位置，將自動對潛在的潛水艇位置空投深水炸彈。</p><p class=\"p_spacing\"> </p><p>深水炸彈將在水中停留一段時間，於潛水艇或其他目標附近引爆。有機率癱瘓配件，引發火災、進水。較容易癱瘓敵方潛水艇的聲納。可拆毀魚雷與水雷，並對水面艦艇造成輕微傷害。</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_DEPTHCHARGE"
msgstr "<p>於水中停留一段時間後，在潛水艇或其他目標附近引爆。</p><p class=\"p_spacing\"> </p><p>有機率癱瘓配件，引發火災、進水。較容易癱瘓敵方潛水艇的聲納。</p><p class=\"p_spacing\"> </p><p>可拆毀魚雷與水雷，並對水面艦艇造成輕微傷害。</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_PINGER"
msgstr "<p>聲納音波會在命中目標時標記所觸區域。聲納制導魚雷將被導向此處。</p><p class=\"p_spacing\"> </p><p>再次命中高亮區域可延長效果時間並提高聲納制導魚雷的機動性。</p><p class=\"p_spacing\"> </p><p>發射出的魚雷將被導向優先目標，即最近一次高亮的艦體區域。</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_SS"
msgstr "<p>在炮彈爆炸區域製造煙幕。煙幕可降低被敵人發現的可能性。</p><p class=\"p_spacing\"> </p><p>這類炮彈<b>不會</b>造成傷害。</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_TORPEDO_SUBDEFAULT"
msgstr "<p>聲納制導魚雷能夠造成可觀的傷害，並有一定機率造成進水。</p><p class=\"p_spacing\"> </p><p>每枚魚雷發射前需向敵艦發射聲納音波進行制導，聲納與魚雷發射管將自動切換。</p><p class=\"p_spacing\"> </p><p>對高機動性及輕型裝甲目標尤為有效。</p>"

msgid "IDS_DOCK_AMMO_DESCRIPTION_TORPEDO_SUBDEFAULT_IMPROVE"
msgstr "<p>聲納制導魚雷能夠造成可觀的傷害，並有一定機率造成進水。</p><p class=\"p_spacing\"> </p><p>每枚魚雷發射前需向敵艦發射聲納音波進行制導，聲納與魚雷發射管將自動切換。</p><p class=\"p_spacing\"> </p><p>對高機動性及輕型裝甲目標尤為有效。</p>"

msgid "IDS_DOCK_AMMO_TITLE_TORPEDO_SUBDEFAULT_IMPROVE"
msgstr "聲納制導魚雷"

msgid "IDS_DOCK_CONSUME_DESCRIPTION_PCY016_SONARSEARCHPREMIUM"
msgstr "<p>可偵測位於潛望深度或水面的潛水艇和水面艦艇，以及魚雷、水雷和深水炸彈（包括位於煙幕區域內的目標）。</p><p class=\"p_spacing\"> </p><p>可顯示位於工作深度潛水艇的粗略位置。</p>"

msgid "IDS_DOCK_CONSUME_DESCRIPTION_PCY020_RLSSEARCHPREMIUM"
msgstr "偵測水面上的潛水艇和艦艇（包括位於煙幕區域內的目標）。"

