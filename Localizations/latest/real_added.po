msgid "IDS_SHIP_ROLE_BB_ASSAULT"
msgstr "突擊型主力艦"

msgid "IDS_SHIP_ROLE_BB_ASSAULT_DESC"
msgstr "<p>逐步推進，以進行近距離作戰。在友軍支援下帶領側翼突破。</p><p class=\"p_spacing\"> </p><p>位居一線。</p>"

msgid "IDS_SHIP_ROLE_BB_FIRE_SUPPORT"
msgstr "支援型主力艦"

msgid "IDS_SHIP_ROLE_BB_FIRE_SUPPORT_DESC"
msgstr "<p>用主炮為友軍提供火力掩護。透過機動使敵軍火力更難命中您的艦艇。</p><p class=\"p_spacing\"> </p><p>位居二線。</p>"

msgid "IDS_SHIP_ROLE_BB_PROVOKE"
msgstr "突圍型主力艦"

msgid "IDS_SHIP_ROLE_BB_PROVOKE_DESC"
msgstr "<p>承受敵軍火力以掩護友軍艦艇。在友軍支援下帶領側翼突破。</p><p class=\"p_spacing\"> </p><p>位居一線。</p>"

msgid "IDS_SHIP_ROLE_BB_SNIPER"
msgstr "狙擊型主力艦"

msgid "IDS_SHIP_ROLE_BB_SNIPER_DESC"
msgstr "<p>依靠隊友提供的偵察情報，從遠距離攻擊敵人。透過機動使敵軍火力更難命中您的艦艇。</p><p class=\"p_spacing\"> </p><p>位居二線。您的艦艇難以承受近距離的火力打擊。</p>"

msgid "IDS_SHIP_ROLE_CA_ASSAULT"
msgstr "突擊型巡洋艦"

msgid "IDS_SHIP_ROLE_CA_ASSAULT_DESC"
msgstr "<p>逐步推進，以進行近距離作戰。在友軍支援下帶領側翼突破。</p><p class=\"p_spacing\"> </p><p>位居一線。</p>"

msgid "IDS_SHIP_ROLE_CA_FIRE_SUPPORT"
msgstr "支援型巡洋艦"

msgid "IDS_SHIP_ROLE_CA_FIRE_SUPPORT_DESC"
msgstr "<p>用主炮為友軍提供火力掩護。進行機動或利用煙霧隱藏自己，使敵軍火力更難命中您的艦艇。</p><p class=\"p_spacing\"> </p><p>位居二線。</p>"

msgid "IDS_SHIP_ROLE_CA_KITAKAMI"
msgstr "雷擊特化型巡洋艦"

msgid "IDS_SHIP_ROLE_CA_KITAKAMI_DESC"
msgstr "<p>將魚雷作為您的主要武器。與敵艦保持距離。偵察敵人的巡洋艦和主力艦。進行機動或利用煙霧隱藏自己，使敵軍火力更難命中您的艦艇。</p><p class=\"p_spacing\"> </p><p>獨特角色。</p>"

msgid "IDS_SHIP_ROLE_CA_SPOTTING"
msgstr "偵察型巡洋艦"

msgid "IDS_SHIP_ROLE_CA_SPOTTING_DESC"
msgstr "<p>使用偵察手段對抗敵軍驅逐艦和輕巡洋艦。支援關鍵區域中的友軍驅逐艦。進行機動或利用煙霧隱藏自己，使敵軍火力更難命中您的艦艇。</p><p class=\"p_spacing\"> </p><p>位居一線。</p>"

msgid "IDS_SHIP_ROLE_CA_TORPEDO"
msgstr "雷擊型巡洋艦"

msgid "IDS_SHIP_ROLE_CA_TORPEDO_DESC"
msgstr "<p>使用魚雷遏制敵人的推進，用主炮為友軍提供火力掩護。進行機動或利用煙霧隱藏自己，使敵軍火力更難命中您的艦艇。</p><p class=\"p_spacing\"> </p><p>位居二線。</p>"

msgid "IDS_SHIP_ROLE_COLON"
msgstr "角色："

msgid "IDS_SHIP_ROLE_CV_ATTACK"
msgstr "打擊型航空母艦"

msgid "IDS_SHIP_ROLE_CV_ATTACK_DESC"
msgstr "<p>使用飛行中隊攻擊敵艦併為隊友提供偵察情報。</p><p class=\"p_spacing\"> </p><p>此角色定位下的航空母艦打擊單一目標的效率最高。</p>"

msgid "IDS_SHIP_ROLE_CV_SUPPORT"
msgstr "支援型航空母艦"

msgid "IDS_SHIP_ROLE_CV_SUPPORT_DESC"
msgstr "<p>使用特殊裝備和中隊支援隊友。</p><p class=\"p_spacing\"> </p><p>此角色定位下的航空母艦打擊效率較低。</p>"

msgid "IDS_SHIP_ROLE_DD_FIRE_SUPPORT"
msgstr "支援型驅逐艦"

msgid "IDS_SHIP_ROLE_DD_FIRE_SUPPORT_DESC"
msgstr "<p>用主炮為友軍提供火力掩護。進行機動或利用煙霧隱藏自己，使敵人更難瞄準您的艦艇。</p><p class=\"p_spacing\"> </p><p>位居二線。</p>"

msgid "IDS_SHIP_ROLE_DD_HUNTER"
msgstr "追獵型驅逐艦"

msgid "IDS_SHIP_ROLE_DD_HUNTER_DESC"
msgstr "<p>用強大的主炮獵殺敵方驅逐艦。進行機動或利用煙霧隱藏自己，使敵人更難瞄準您的艦艇。佔領關鍵區域，拾取增益，並控制戰場上的其他重要區域。為隊友提供偵察情報。</p><p class=\"p_spacing\"> </p><p>位居一線。</p>"

msgid "IDS_SHIP_ROLE_DD_PAOLO_EMILIO"
msgstr "突襲型驅逐艦"

msgid "IDS_SHIP_ROLE_DD_PAOLO_EMILIO_DESC"
msgstr "<p>埋伏在島嶼後方伺機而動，或配合使用「高速發煙器」和「引擎增壓」消耗品發動毀滅性魚雷打擊。進行機動或利用煙霧隱藏自己，使敵人更難瞄準您的艦艇。為隊友提供偵察情報。</p><p class=\"p_spacing\"> </p><p>獨特角色。</p>"

msgid "IDS_SHIP_ROLE_DD_TORPEDO"
msgstr "雷擊型驅逐艦"

msgid "IDS_SHIP_ROLE_DD_TORPEDO_DESC"
msgstr "<p>從側翼包抄敵人，以實施最有效的魚雷打擊。為隊友提供偵察情報。佔領關鍵區域，拾取增益，並控制戰場上的其他重要區域。</p><p class=\"p_spacing\"> </p><p>位居一線。</p>"

msgid "IDS_SHIP_ROLE_DD_UNIVERSAL"
msgstr "全能型驅逐艦"

msgid "IDS_SHIP_ROLE_DD_UNIVERSAL_DESC"
msgstr "<p>根據局勢使用主炮或魚雷。</p><p class=\"p_spacing\"> </p><p>從側翼包抄敵人，以實施最有效的魚雷打擊。用主炮為友軍提供火力掩護。佔領關鍵區域，拾取增益，並控制戰場上的其他重要區域。為隊友提供偵察情報。</p>"

msgid "IDS_SHIP_ROLE_DETAILED_COLON"
msgstr "您的角色："

msgid "IDS_SHIP_ROLE_SS_SILENT_HUNTER"
msgstr "潛獵型潛艇"

msgid "IDS_SHIP_ROLE_SS_SILENT_HUNTER_DESC"
msgstr "使用魚雷進行隱秘的攻擊。在水面上或處於潛望鏡深度/工作深度時使用被動聲吶為隊友提供偵察情報。佔領關鍵區域，拾取增益，並控制戰場上的其他重要區域。"

msgid "IDS_SHIP_ROLE_SS_SURCOUF"
msgstr "類巡洋型潛艇"

msgid "IDS_SHIP_ROLE_SS_SURCOUF_DESC"
msgstr "<p>使用魚雷進行隱秘的攻擊。在水面上使用可旋轉魚雷發射管。同時使用主炮和魚雷，與驅逐艦短兵相接。在安全距離使用「偵察機」消耗品，以利用主炮火力為友軍提供掩護。在水面上或處於潛望鏡深度/工作深度時使用被動聲吶為友軍提供偵察情報。</p><p class=\"p_spacing\"> </p><p>獨特角色。</p>"

